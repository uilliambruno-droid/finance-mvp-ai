# OpenRouter (recommended primary provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BASE_SECONDS=1.2

# LLM context/cost tuning
LLM_MAX_OUTPUT_TOKENS=1000
LLM_CONTEXT_RECENT_MESSAGES=4
LLM_CONTEXT_TOP_CATEGORIES=3
LLM_CONTEXT_PRODUCTS=6

# Ollama (optional local fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct

# Environment
ENVIRONMENT=development
# Optional for development: disable OTP auth gate when email rate-limits are a blocker
AUTH_REQUIRED=true
# Keep simplified valid-email login (no token check) for local testing
EMAIL_LOGIN_REQUIRED=true

# Supabase auth + per-user persistence (optional, recommended)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_USER_STATES_TABLE=user_states
SUPABASE_EMAIL_REDIRECT_TO=http://localhost:8501

# Access restrictions without open signup (optional)
# Comma-separated list: email1@domain.com,email2@domain.com
SUPABASE_ALLOWED_EMAILS=
# Comma-separated list: company.com,partner.com
SUPABASE_ALLOWED_DOMAINS=
