# OpenRouter (provider principal recomendado)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BASE_SECONDS=1.2

# Ajustes de custo/contexto do LLM
LLM_MAX_OUTPUT_TOKENS=1000
LLM_CONTEXT_RECENT_MESSAGES=4
LLM_CONTEXT_TOP_CATEGORIES=3
LLM_CONTEXT_PRODUCTS=6

# Ollama (fallback local - opcional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct

# Ambiente
ENVIRONMENT=development
# Opcional para desenvolvimento: desativa tela de login quando o rate limit de email atrapalhar
AUTH_REQUIRED=true
# Mantem login simplificado por email valido (sem token) para testes locais
EMAIL_LOGIN_REQUIRED=true

# Supabase Auth + persistência por usuário (opcional, recomendado para login profissional)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_USER_STATES_TABLE=user_states
SUPABASE_EMAIL_REDIRECT_TO=http://localhost:8501

# Controle de acesso sem cadastro aberto (opcional)
# Separe por virgula: email1@dominio.com,email2@dominio.com
SUPABASE_ALLOWED_EMAILS=
# Separe por virgula: empresa.com,parceiro.com
SUPABASE_ALLOWED_DOMAINS=
